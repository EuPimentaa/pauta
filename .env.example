# Copie para .env (não versionado) e preencha. Em produção, defina estas variáveis no EasyPanel.
# Agentes em paralelo: um .env.<nome> por agente (PLANO §0, regra 7).

# Porta da API + SSE (7300; agente N: 7310 + N).
PORT=7300
# Banco (demandas.db), uploads/ e backups/. Em produção: /app/data (volume).
DATA_DIR=./data
# Origem do app. Em desenvolvimento, a do Vite (o anti-CSRF compara o Origin): http://localhost:5173.
APP_URL=http://localhost:5173
APP_NOME=Pauta
# 32+ bytes aleatórios (assina URLs de arquivo, cifra o token dos links públicos, HMAC do IP). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Obrigatório em produção; em desenvolvimento, sem ele, cada execução sorteia um (os links antigos param de abrir).
SEGREDO=
# development | production (produção: cookie __Host-sid, CSP, web/dist servido pelo Node, escuta em 0.0.0.0).
NODE_ENV=development
# Proxies confiáveis que acrescentam ao X-Forwarded-For: 0 em desenvolvimento; 1 atrás do Traefik do EasyPanel;
# 2 com a Cloudflare na frente.
TRUST_PROXY_HOPS=0
# Só no primeiro boot (banco sem usuários): cria o admin. Depois, tire do ambiente.
ADMIN_EMAIL=
ADMIN_SENHA=

# ─── Fase 2 (docs/FASE2-PLANO.md §1.3) ───
# Windsor.ai (resultados dos clientes): a chave de API da conta da agência. Só no servidor (EasyPanel); nunca vai ao
# navegador nem aos logs. Vazia = a aba Resultados mostra "A integração com a Windsor não está configurada".
# Só em desenvolvimento: WINDSOR_API_KEY=fixtures lê as fixtures de server/test/fixtures/resultados/ (sem rede).
WINDSOR_API_KEY=
# MCP do Claude (/mcp + OAuth): 1 (padrão) liga; 0 desliga /mcp, /oauth/* e /.well-known/oauth-* (404) na hora.
MCP_ATIVO=1
# Opcional: redirect_uri https de outro cliente MCP aceitos no registro, separados por vírgula (os do Claude e o
# loopback do Claude Code já valem). Ex.: https://outro.exemplo/oauth/callback
MCP_REDIRECTS_EXTRAS=
# Opcional: Origins https aceitos no POST /mcp, separados por vírgula (APP_URL, claude.ai e claude.com já valem;
# Origin ausente também). Ex.: https://inspector.exemplo
MCP_ORIGENS_EXTRAS=
# A agenda da Melt (iCal) não usa variável: o endereço secreto é colado pelo admin em Configurações → Agendas externas
# e fica cifrado com o SEGREDO (trocar o SEGREDO obriga a colar os endereços de novo).

# Seed de demonstração (npm run seed:demo --workspace server; só desenvolvimento).
# Senha das pessoas da demonstração (<chave>@pauta.test); vazio = ADMIN_SENHA.
SEED_SENHA=
# Cards da Criação (o resto dos quadros tem quantidade fixa).
SEED_DEMANDAS=300

# Front em desenvolvimento (Vite): para onde o /api é encaminhado.
# API_URL=http://127.0.0.1:7300
